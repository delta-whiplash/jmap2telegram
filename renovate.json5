{
  // Renovate for jmap2telegram, run by .github/workflows/renovate.yml on a
  // schedule rather than from a self-hosted instance. It replaces Dependabot
  // (+ the dependabot-auto-merge.yml that went with it): one bot, native
  // automerge, lockFileMaintenance - none of which Dependabot covered here.
  //
  // It needs a token of its own (a GitHub App, see the workflow): the PRs it
  // opens must trigger this repository's CI, and the default GITHUB_TOKEN
  // cannot do that.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":semanticCommits",
    "docker:pinDigests", // Dockerfile: FROM rust:1-slim-bookworm → digest
    "helpers:pinGitHubActionDigests",
  ],
  timezone: "Europe/Paris",
  schedule: ["after 6am", "before 10pm"],
  labels: ["renovate", "dependencies"],
  dependencyDashboard: true,
  rebaseWhen: "behind-base-branch",
  prConcurrentLimit: 10,
  platformAutomerge: false,

  // Cargo: clippy -D warnings and the test suite must stay green to merge.
  // Patch/minor merge themselves once CI is green; major is left for manual
  // review (a breaking API change is not something the test suite detects).
  packageRules: [
    {
      description: "Cargo minor+patch grouped, automerged behind green CI",
      matchManagers: ["cargo"],
      matchUpdateTypes: ["patch", "minor"],
      groupName: "cargo minor+patch",
      automerge: true,
      automergeType: "pr",
    },
    {
      description: "Cargo major: manual review",
      matchManagers: ["cargo"],
      matchUpdateTypes: ["major"],
      automerge: false,
    },
    {
      description: "GitHub Actions: digest-pinned minor+patch, automerged",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["patch", "minor"],
      groupName: "github-actions minor+patch",
      automerge: true,
      automergeType: "pr",
    },
    {
      description: "Docker (rust builder image): manual review, rare and breakable",
      matchManagers: ["dockerfile"],
      automerge: false,
    },
  ],

  // Refresh Cargo.lock without a version bump (transitive CVEs) - weekly.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 5am on monday"],
    automerge: true,
    automergeType: "pr",
  },

  // Two independent sources, deliberately:
  //  - vulnerabilityAlerts reads the platform's alerts (GitHub's dependency
  //    graph + Dependabot alerts, enabled as a repository setting);
  //  - osvVulnerabilityAlerts queries OSV.dev directly for direct
  //    dependencies, so the security lane does not hinge on one toggle
  //    staying enabled.
  vulnerabilityAlerts: {
    enabled: true,
    labels: ["security-alert", "priority-critical"],
  },
  osvVulnerabilityAlerts: true,
}
