# Copy to .env and fill in. Only these two variables are required — your
# JMAP server URL and token are provided later, live, via /login in the
# Telegram chat itself.

# Bearer token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat ids allowed to use this bot. To find
# yours, start the bot with a placeholder here (e.g. 0), send it any
# message from Telegram, and read the "unauthorized access attempt" WARN
# line it logs (docker logs -f jmap2telegram) — or just ask
# @userinfobot for your id. See "Finding your Telegram chat id" in
# README.md for the full walkthrough.
AUTHORIZED_CHAT_IDS=

# Optional. Off by default: refuses /login to a JMAP server that resolves
# to a private/loopback/link-local address (SSRF protection). Only set
# to 1 if you're deliberately pointing the bot at an internal JMAP server.
# ALLOW_PRIVATE_JMAP_HOSTS=1

# Optional. IANA zone name for notification/log timestamps. Defaults to UTC.
# TIMEZONE=Europe/Paris

# Optional. trace, debug, info, warn, or error. Defaults to info.
# LOG_LEVEL=info

# Optional, advanced: tracing's per-module filter syntax, overrides
# LOG_LEVEL when set.
# RUST_LOG=jmap2telegram=debug,teloxide=info
